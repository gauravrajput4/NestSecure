# ---- Core (required) ----
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pgbooking
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# ---- Razorpay (optional — demo mode if blank) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Email / Nodemailer (optional — logs to console if blank) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PG Booking <no-reply@pgbooking.app>"

# ---- Twilio WhatsApp (optional — logs to console if blank) ----
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Cloudinary (optional — image uploads disabled if blank) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
